{
  "format_version": 1,
  "system": "ci-jobs-infra",
  "level": "service",
  "components": [
    {
      "id": "api",
      "kind": "api-gateway"
    },
    {
      "id": "distributor",
      "kind": "dispatcher"
    },
    {
      "id": "worker-pool",
      "kind": "executor-pool"
    },
    {
      "id": "pg",
      "kind": "database"
    },
    {
      "id": "redis",
      "kind": "cache"
    },
    {
      "id": "web",
      "kind": "web-frontend"
    },
    {
      "id": "billing-web",
      "kind": "unrelated-service"
    }
  ],
  "edges": [
    {
      "from": "api",
      "to": "distributor"
    },
    {
      "from": "distributor",
      "to": "worker-pool"
    },
    {
      "from": "distributor",
      "to": "pg",
      "note": "scan + dispatch bookkeeping"
    },
    {
      "from": "api",
      "to": "pg"
    },
    {
      "from": "web",
      "to": "api"
    },
    {
      "from": "web",
      "to": "redis"
    }
  ]
}
