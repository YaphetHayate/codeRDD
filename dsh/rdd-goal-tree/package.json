{
  "name": "@coderrdd/dsh-rdd-goal-tree",
  "version": "0.3.0",
  "description": "dsh profile bundle: read-only goal-tree run status — a dock strip above the composer fed by the host half's /rdd-goal-tree endpoint over .rdd/goal-trees state files; worker sessions see their own node, worker reports call back to the Planner session's inbox",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node ../../scripts/build-dsh-goal-tree.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaphetHayate/codeRDD.git",
    "directory": "dsh/rdd-goal-tree"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
